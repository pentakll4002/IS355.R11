# Docker Environment Variables for IS355 DAO Project
# Copy this file to .env and fill in values as needed

# Optional: Pinata IPFS JWT for real IPFS pinning
# Leave blank to use local cache mode (default for demo)
PINATA_JWT=

# Optional: Custom IPFS Gateway
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional: Sepolia testnet deployment (for real-network demo)
# SEPOLIA_RPC_URL=https://rpc.sepolia.org
# PRIVATE_KEY=0x...your_private_key_here
